# ============================================================
#  Wzór pliku .env
#
#  Skopiuj na `.env` i odkomentuj JEDEN z dwóch wariantów poniżej,
#  wstawiając własne dane. Oba są wyłączone celowo — gdyby któryś
#  działał od razu z przykładowymi wartościami, aplikacja próbowałaby
#  się łączyć z nieistniejącym serwerem i myliła w diagnozie.
#
#  `.env` jest w .gitignore i nie trafi do repozytorium. To jedyne
#  miejsce, w którym hasło ma prawo się pojawić.
#
#  Na hostingu pliku .env nie ma — te same nazwy ustawia się
#  w panelu usługi, w sekcji zmiennych środowiskowych.
# ============================================================


# --- WARIANT 1: jeden adres (wygodniejszy) ---
# Usuń `#` z linii poniżej i wstaw swoje dane.
# Kształt: mysql://uzytkownik:haslo@serwer:port/nazwa_bazy
#
# UWAGA na znaki specjalne w haśle. Jeśli zawiera @ : / ? # albo %,
# ten wariant się wyłoży — użyj wtedy wariantu 2.

#MYSQL_URL=mysql://mojlogin:mojehaslo@serwer.przyklad.pl:3306/mojabaza


# --- WARIANT 2: osobne pola (bezpieczniejszy przy dziwnych hasłach) ---
# Usuń `#` z pięciu linii poniżej. Tu żadnych znaków nie trzeba kodować,
# hasło wklejasz dokładnie takie, jakie masz w panelu.
#
# Jeśli używasz tego wariantu, linia MYSQL_URL wyżej MUSI zostać
# zakomentowana — ma pierwszeństwo i przesłoniłaby te ustawienia.

#DB_HOST=serwer.przyklad.pl
#DB_PORT=3306
#DB_USER=mojlogin
#DB_PASSWORD=mojehaslo
#DB_NAME=mojabaza


# --- Port serwera aplikacji ---
# Lokalnie bez znaczenia. Na hostingu ustawiany automatycznie,
# nie dopisuj go tam ręcznie.
#PORT=8080
